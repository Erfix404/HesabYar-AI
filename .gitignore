# ==============================================================================
# HesabYar-AI .gitignore
# ==============================================================================

# 1. Python & Environment Artifacts
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# 2. Sensitive Data, Certificates & Credentials (CRITICAL for Moadian)
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
secrets/
credentials/
*token*
auth.json

# 3. Claude & Agent Scaffolding
CLAUDE.md
claude.md
.claude/
.claude*
.gstack/
.gstack*
.agents/

# 4. Hermes Scaffolding & State
HERMES.md
.hermes/
.hermes*

# 5. Workspace, Scratch & Logs
.scratch/
*.log
logs/*.log
*.tmp
*.bak
*.swp
*.swo

# 6. Operating System & Editor Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 7. Upstream & Large Source Document Exclusions
standards/*/source/*.doc
standards/*/source/*.pdf
standards/*/source/media/
standards/*/source/*.docx
standards/*/source/s*.doc
scripts/test_*.py

# Python build artifacts
dist/
build/
*.egg-info/
